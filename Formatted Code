# Student Information Formatter - Version 2
# Added string formatting methods (title, upper, strip)

first_name = input("Enter first name: ").strip()
last_name = input("Enter last name: ").strip()
section = input("Enter section: ").strip()
favorite_subject = input("Enter favorite subject: ").strip()

full_name = f"{first_name} {last_name}".title()
name_code = f"{first_name} {last_name}".upper()
section_formatted = section.upper()
subject_formatted = favorite_subject.title()
char_count = len(full_name)

print("\nFormatted Output:")
print(f"Name: {full_name}")
print(f"Name Code: {name_code}")
print(f"Section: {section_formatted}")
print(f"Favorite Subject: {subject_formatted}")
print(f"Character Count: {char_count}")
